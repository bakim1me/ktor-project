<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{REQUEST_ID}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="kr.co.dsdo.boilerplate" level="INFO" />
    <logger name="Exposed" level="DEBUG" />
    <logger name="InboundLogger" level="DEBUG" />
    <logger name="OutboundLogger" level="DEBUG" />
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
</configuration>